// Prisma schema for Portfolio Watcher
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  hashedPassword String
  name           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Two-factor auth (TOTP). Secret is encrypted at rest (see src/lib/crypto.ts),
  // same AES-256-GCM approach already used for Plaid access tokens.
  encryptedTotpSecret String?
  twoFactorEnabled    Boolean   @default(false)
  failedTotpAttempts  Int       @default(0)
  totpLockedUntil     DateTime?

  // Which version of the Terms of Service / Privacy Policy this user has
  // agreed to, and when. Null means never agreed (blocks access until they
  // do); a version below CURRENT_TERMS_VERSION (src/lib/legal.ts) means the
  // docs changed since and they must re-agree.
  termsAcceptedVersion Int?
  termsAcceptedAt      DateTime?

  goal                 Goal?
  exitRules            ExitRule[]
  plaidItems           PlaidItem[]
  watchlistItems       WatchlistItem[]
  reports              Report[]
  passwordResetTokens  PasswordResetToken[]
  twoFactorBackupCodes TwoFactorBackupCode[]
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Goal {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCoreEtfPct     Float
  targetGrowthPct      Float
  targetSpeculativePct Float
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum ExitRuleType {
  PRICE_TARGET
  TRAILING_STOP_PCT
  STOP_LOSS_PRICE
}

model ExitRule {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker    String
  ruleType  ExitRuleType
  value     Float
  note      String?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, ticker])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker    String
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, ticker])
}

model PlaidItem {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId          String    @unique
  encryptedAccessToken String
  institutionName      String?
  status               String    @default("active") // active | login_required | error
  lastHoldingsJson     String?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
}

enum ReportType {
  DAILY_DIGEST
  WEEKLY_TRENDS
  BREAKING_NEWS
}

model Report {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              ReportType
  schemaVersion     Int        @default(1)
  content           String // JSON-stringified structured report
  hasMaterialEvents Boolean    @default(true) // BREAKING_NEWS only
  model             String
  inputTokens       Int?
  outputTokens      Int?
  generatedAt       DateTime   @default(now())

  @@index([userId, type, generatedAt])
}
