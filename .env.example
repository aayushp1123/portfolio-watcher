DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""              # generate locally: openssl rand -base64 32

# REQUIRES a free signup: https://dashboard.plaid.com/signup (Sandbox key issued instantly, $0)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_TOKEN_ENCRYPTION_KEY=""   # generate locally: openssl rand -hex 32

# REQUIRES a free signup: https://aistudio.google.com/apikey — free tier, no billing required.
# Leave blank to keep AI report generation and the scheduled reports fully disabled.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Shared secret Vercel Cron sends back to verify scheduled report requests.
# generate locally: openssl rand -hex 32
CRON_SECRET=""

# OPTIONAL, free signup: https://fred.stlouisfed.org/docs/api/api_key.html
# Adds real Fed funds rate / CPI / unemployment context to Weekly Trends.
# Leave blank to skip -- reports work fine without it.
FRED_API_KEY=""

# OPTIONAL, zero new signup -- uses your existing Gmail account's free App
# Password (myaccount.google.com/apppasswords, requires 2-Step Verification
# to be on). Powers "forgot password" emails via free Gmail SMTP.
# Leave blank to skip -- forgot-password requests just won't send an email.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
